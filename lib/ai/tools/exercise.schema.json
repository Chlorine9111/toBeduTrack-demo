{
  "name": "return_exercises",
  "description": "Return an array of AP-aligned exercises.",
  "input_schema": {
    "type": "object",
    "required": ["exercises"],
    "properties": {
      "exercises": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "questionText",
            "type",
            "difficulty",
            "topicId",
            "correctAnswer",
            "solutionSteps"
          ],
          "properties": {
            "questionText": { "type": "string" },
            "stem": { "type": "string" },
            "type": { "type": "string", "enum": ["MC", "FR"] },
            "questionType": { "type": "string", "enum": ["MCQ", "FRQ"] },
            "question_type": { "type": "string", "enum": ["MCQ", "FRQ"] },
            "difficulty": { "type": "integer", "minimum": 1, "maximum": 4 },
            "difficultyLabel": { "type": "string", "enum": ["easy", "medium", "hard"] },
            "difficulty_label": { "type": "string", "enum": ["easy", "medium", "hard"] },
            "topicId": { "type": "string" },
            "topic_id": { "type": "string" },
            "loIds": { "type": "array", "items": { "type": "string" } },
            "lo_ids": { "type": "array", "items": { "type": "string" } },
            "ekIds": { "type": "array", "items": { "type": "string" } },
            "ek_ids": { "type": "array", "items": { "type": "string" } },
            "options": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "text", "isCorrect"],
                    "properties": {
                      "label": { "type": "string" },
                      "text": { "type": "string" },
                      "isCorrect": { "type": "boolean" }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["A", "B", "C", "D"],
                  "properties": {
                    "A": { "type": "string" },
                    "B": { "type": "string" },
                    "C": { "type": "string" },
                    "D": { "type": "string" }
                  }
                }
              ]
            },
            "correctAnswer": { "type": "string" },
            "correct_answer": { "type": "string" },
            "solutionSteps": { "type": "string" },
            "solution": { "type": "string" },
            "commonMistakes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "distractorRationale": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "distractor_rationale": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "parts": { "type": "object" },
            "totalPoints": { "type": "number" },
            "total_points": { "type": "number" }
          }
        }
      }
    }
  }
}
