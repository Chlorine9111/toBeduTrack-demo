{
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "dev:turbo": "next dev --turbopack -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "lint": "eslint . --ignore-pattern '.next/**' --ignore-pattern '.next-dev/**' --ignore-pattern 'document/**'",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check:file-budgets": "tsx scripts/check-file-budgets.ts",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:all": "npm run lint && npm run check:file-budgets && npm run check:architecture && npm run check:docs && npm run typecheck",
    "quota:verify": "node --import tsx scripts/quota/verify-backend-logic.ts",
    "quota:verify:real": "node --env-file=.env.local --import tsx scripts/quota/verify-real-usage.ts",
    "quota:dev:unlimit": "node --env-file=.env.local --import tsx scripts/quota/dev-account.ts unlimit",
    "quota:dev:reset": "node --env-file=.env.local --import tsx scripts/quota/dev-account.ts reset",
    "e2e": "playwright test",
    "scan:iterate": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/pdf-scan/competition-iteration.ts",
    "scan:parser-regression": "tsx scripts/pdf-scan/parser-regression.ts",
    "context:regression": "tsx scripts/context/context-engineering-regression.ts",
    "knowledge:rag:regression": "tsx scripts/assistant/knowledge-rag-regression.ts",
    "grading:jobs:process": "node --env-file=.env.local --import tsx scripts/grading/process-jobs.ts",
    "background-tasks:process": "node --env-file=.env.local --import tsx scripts/runtime/process-background-task-replays.ts",
    "question-bank:taxonomy:dry": "node --env-file=.env.local --import tsx scripts/question-bank/backfill-exercise-taxonomy.ts --dry-run",
    "question-bank:taxonomy": "node --env-file=.env.local --import tsx scripts/question-bank/backfill-exercise-taxonomy.ts",
    "pbl:collect": "tsx scripts/pbl/collect-materials.ts && tsx scripts/pbl/enrich-material-content.ts && tsx scripts/pbl/collect-knowledgepoints.ts",
    "pbl:topics:derive": "node --import tsx scripts/pbl/derive-material-topics.ts --write",
    "pbl:apced:topics:dry": "node --env-file=.env.local --import tsx scripts/pbl/backfill-apced-material-topics.ts --dry-run",
    "pbl:apced:topics": "node --env-file=.env.local --import tsx scripts/pbl/backfill-apced-material-topics.ts",
    "pbl:seed:dry": "tsx scripts/pbl/seed-supabase.ts --dry-run",
    "pbl:seed": "tsx scripts/pbl/seed-supabase.ts",
    "pbl:mkp:dry": "tsx scripts/pbl/backfill-material-knowledge-links.ts --dry-run",
    "pbl:mkp": "tsx scripts/pbl/backfill-material-knowledge-links.ts",
    "pbl:smoke": "tsx scripts/pbl/smoke-pbl-generate.ts"
  },
