# Supabase 项目设置 > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage（可选）
QUESTION_IMAGE_BUCKET=pdfs
WECHAT_EDITOR_STORAGE_BUCKET=pdfs

# 通用文本模型（Qwen via DashScope，可选）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_PRIMARY_MODEL=qwen-plus

# Anthropic / Claude（可选 legacy 专项链路）
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VISION_MODEL=
# 分层覆盖（可选）
ANTHROPIC_MODEL_CORE=
ANTHROPIC_MODEL_AUX=
ANTHROPIC_MODEL_TOOL=
ANTHROPIC_INTENT_MODEL=
ANTHROPIC_ASSISTANT_MODEL=
ANTHROPIC_ASSISTANT_CHAT_MODEL=
ANTHROPIC_ASSISTANT_LESSON_PLAN_MODEL=
ANTHROPIC_ASSISTANT_EXERCISES_MODEL=
ANTHROPIC_ASSISTANT_RUBRIC_MODEL=
ANTHROPIC_PBL_ASSISTANT_MODEL=
# 可选：自定义 SDK 网关地址（兼容旧变量）
ANTHROPIC_SDK_BASE_URL=

# OpenRouter（可选 fallback / specialist 链路）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=toBeduTrack
OPENROUTER_PERPLEXITY_MODEL=perplexity/sonar
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_QUESTION_TAXONOMY_MODEL=google/gemini-3-flash-preview
OPENROUTER_OCR_MODEL=

# Moonshot (Kimi) 配置（可选 legacy 兜底）
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_API_BASE=https://api.moonshot.cn/v1
# 兼容别名（可选）
MOONSHOT_BASE_URL=
INTENT_TIMEOUT_MS=9000

# 模型分层（可选）
MOONSHOT_MODEL_CORE=kimi-k2-turbo-preview
MOONSHOT_MODEL_AUX=kimi-k2-turbo-preview
MOONSHOT_MODEL_TOOL=kimi-k2-turbo-preview

# 调用点级覆盖（可选，未设置时按分层模型回退）
MOONSHOT_EXERCISE_MODEL=
MOONSHOT_RUBRIC_MODEL=
MOONSHOT_EXERCISE_VERIFY_MODEL=
MOONSHOT_EXERCISE_EQUIV_MODEL=
MOONSHOT_INTENT_MODEL=
MOONSHOT_QUESTION_TAXONOMY_MODEL=google/gemini-3-flash-preview
MOONSHOT_LESSON_SECTION_MODEL=
MOONSHOT_LESSON_OUTLINE_MODEL=
MOONSHOT_LESSON_REWRITE_MODEL=

# PDF 扫描模型（可选）
MOONSHOT_PDF_VISION_MODEL=
MOONSHOT_PDF_PARSE_MODEL=
MOONSHOT_WECHAT_VISION_MODEL=

# Mathpix OCR（PDF 扫描功能必需）
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# 视觉版面分析（可选）
USE_VISION_LAYOUT=true
PDF_RENDER_SCALE=2
PDF_MAX_CONCURRENCY=2
PDF_BROWSER_IDLE_MS=30000
PDF_RENDER_TIMEOUT_MS=120000

# 题目与 Rubric 生成控制
EXERCISE_VERIFY_MAX_ATTEMPTS=2
RUBRIC_GENERATE_ATTEMPTS=2

# 运行环境
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=http://localhost:3001
E2E_TEST=0

# Interview Demo 登录（仅本地开发；登录页不保存或发送邮箱与密码）
# 需要免登录浏览界面时，将下方两个开关设为 true，并提供本地测试教师 UUID。
AUTH_BYPASS=false
NEXT_PUBLIC_AUTH_BYPASS=false
AUTH_BYPASS_ALLOW_PRODUCTION=false
AUTH_BYPASS_USER_ID=your-auth-user-id
EXERCISE_SKIP_VERIFY=false

# 反馈后台管理员（推荐）
# 逗号分隔的 teacher UUID。生产建议优先配数据库表 public.feedback_admins。
FEEDBACK_ADMIN_USER_IDS=

# Supermemory（老师长期记忆主存储）
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
# containerTag 前缀，最终会拼接为: <prefix>:<scope>:<profileKey>
SUPERMEMORY_CONTAINER_PREFIX=toBeduTrack_teacher_memory

# 邀请码系统
# 管理员密钥（用于批量生成邀请码的 API 鉴权）
INVITE_ADMIN_SECRET=your-admin-secret
# [已废弃] 旧的单一邀请码环境变量，已被数据库方案替代
# INVITE_CODE=

# Tiptap Pro / Cloud（Demo 可留空，使用本地占位适配层）
NEXT_PUBLIC_TIPTAP_APP_ID=
TIPTAP_CLOUD_AI_SECRET=
